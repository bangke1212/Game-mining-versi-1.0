# X/Twitter OAuth 2.0 + PKCE
TWITTER_CLIENT_ID=
# Required for a confidential Web App; leave empty for a public Single Page App using PKCE.
TWITTER_CLIENT_SECRET=
# Must exactly match the callback URL registered in the X Developer Console.
TWITTER_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN.vercel.app/api/auth/twitter/callback

# Random 32+ character secret used to sign the session cookie
AUTH_SECRET=
